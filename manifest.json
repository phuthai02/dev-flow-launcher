{
  "manifest_version": 3,
  "name": "Dev Flow Launcher",
  "version": "0.1.12",
  "minimum_chrome_version": "106",
  "description": "Create GitLab merge requests and trigger Jenkins builds without leaving the current tab.",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Dev Flow Launcher",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
